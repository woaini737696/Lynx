{
  "name": "lynx-desktop",
  "version": "1.0.14",
  "description": "奇思 - AI工作台 - 桌面端（Electron 主架构）",
  "main": "src/main.js",
  "author": "Lynn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/woaini737696/Lynx.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:win": "npm run build:renderer && node scripts/gen-cert.cjs && node scripts/gen-white-bmps.cjs && node scripts/gen-license.cjs && electron-builder --win nsis && node scripts/sign-installer.cjs",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build": "npm run build:win"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0"
  },
  "build": {
    "appId": "com.lynnhub.desktop",
    "productName": "奇思",
    "copyright": "© 2026 Lynn. All rights reserved.",
    "directories": {
      "output": "release-v14",
      "buildResources": "build"
    },
    "publish": null,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "renderer/**/*",
      "resources/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "electronDownload": {
      "cache": "node_modules/.cache/electron"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "artifactName": "QisiSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "奇思"
    },
    "compression": "maximum"
  }
}
