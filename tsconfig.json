{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "desktop-native/dist-web/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_test_workbuddy_",
    "web_Lynx",
    "Temp",
    "test-hello",
    "npm-cache",
    "android",
    "mobile",
    "desktop",
    "dist",
    "e2e",
    "desktop-native"
  ]
}
