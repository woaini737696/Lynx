{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LynnHub 桌面端默认权限配置",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:5176/**",
      "http://127.0.0.1:5176/**",
      "https://app.lynnhub.com/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:tray:default",
    "core:menu:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "http://localhost:5176/**" },
        { "url": "http://127.0.0.1:5176/**" },
        { "url": "https://app.lynnhub.com/**" },
        { "url": "https://**" },
        { "url": "mailto:**" }
      ]
    },
    "shell:default",
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/LynnHub/user-data/**" },
        { "path": "$APPLOCALDATA/LynnHub/user-data/**" },
        { "path": "$HOME/Library/Application Support/LynnHub/user-data/**" },
        { "path": "$HOME/.local/share/LynnHub/user-data/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://localhost:5176/**" },
        { "url": "http://127.0.0.1:5176/**" },
        { "url": "https://app.lynnhub.com/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-cancel",
      "allow": [
        { "url": "http://localhost:5176/**" },
        { "url": "http://127.0.0.1:5176/**" },
        { "url": "https://app.lynnhub.com/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-read-body",
      "allow": [
        { "url": "http://localhost:5176/**" },
        { "url": "http://127.0.0.1:5176/**" },
        { "url": "https://app.lynnhub.com/**" }
      ]
    },
    {
      "identifier": "http:allow-fetch-send",
      "allow": [
        { "url": "http://localhost:5176/**" },
        { "url": "http://127.0.0.1:5176/**" },
        { "url": "https://app.lynnhub.com/**" }
      ]
    },
    "global-shortcut:default"
  ]
}
