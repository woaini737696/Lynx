{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationBarTitleText": "今日聚焦" }
    },
    {
      "path": "pages/board/board",
      "style": { "navigationBarTitleText": "决策看板" }
    },
    {
      "path": "pages/ai/chat/chat",
      "style": { "navigationBarTitleText": "AI 助理" }
    },
    {
      "path": "pages/tasks/tasks",
      "style": {
        "navigationBarTitleText": "飞书任务",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/settings/settings",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/login/login",
      "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" }
    },
    {
      "path": "pages/inbox/inbox",
      "style": { "navigationBarTitleText": "灵感收件箱" }
    },
    {
      "path": "pages/memory/memory",
      "style": { "navigationBarTitleText": "记忆认知" }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "LynnHub",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f5f7",
    "app-plus": {
      "background": "#f5f5f7"
    }
  },
  "tabBar": {
    "custom": true,
    "color": "#86868b",
    "selectedColor": "#f59e0b",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "聚焦" },
      { "pagePath": "pages/board/board", "text": "看板" },
      { "pagePath": "pages/ai/chat/chat", "text": "助理" },
      { "pagePath": "pages/tasks/tasks", "text": "任务" },
      { "pagePath": "pages/settings/settings", "text": "我的" }
    ]
  }
}
