// LynnHub Prisma Schema
// 数据库：MySQL 8.4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户系统
model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @db.VarChar(255)
  email        String?  @unique @db.VarChar(255)
  displayName  String   @default("") @db.VarChar(100)
  role         String   @default("viewer") // admin | editor | viewer
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ideas         Idea[]
  conversations Conversation[]
  tasks         Task[]
  memories      Memory[]
  cognitions    Cognition[]
  dailyFocuses  DailyFocus[]
  skills        Skill[]
  skillReviews  SkillReview[]
  chatSessions  ChatSession[]
  flows         Flow[]
  flowExecutions FlowExecution[]
  pushSubscriptions PushSubscription[]
}

// 灵感 - 闪电输入源头
model Idea {
  id        String   @id @default(cuid())
  content   String   @db.Text
  source    String   @default("lightning") // lightning | conversation
  status    String   @default("inbox") // inbox | board | graveyard
  tags      Json     @default("[]")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?        @relation(fields: [userId], references: [id])
  tasks      Task[]
  memories   Memory[]
  graveyard  Graveyard?
  cognitions Cognition[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// 对话资产 - Kimi/Claude/Codex 捕获
model Conversation {
  id          String   @id @default(cuid())
  source      String   // kimi | claude | codex | gpt
  title       String
  rawContent  String   @db.LongText
  conclusions Json     @default("[]")
  todos       Json     @default("[]")
  prompts     Json     @default("[]")
  data        Json     @default("[]")
  capturedAt  DateTime @default(now())
  userId      String?
  createdAt   DateTime @default(now())

  user        User?         @relation(fields: [userId], references: [id])
  memories    Memory[]
  cognitions  Cognition[]

  @@index([source])
  @@index([capturedAt])
  @@index([userId])
}

// 决策看板任务
model Task {
  id        String   @id @default(cuid())
  content   String   @db.Text
  column    String   // northstar | campaign | task
  position  Int      @default(0)
  status    String   @default("active") // active | done | dropped
  sourceId  String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea Idea? @relation(fields: [sourceId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  dailyFocusItems DailyFocusItem[]

  @@index([column, status])
  @@index([userId])
}

// 记忆节点 - 图谱
model Memory {
  id              String   @id @default(cuid())
  type            String   // idea | conversation | cognition
  ideaId          String?
  conversationId  String?
  cognitionId     String?
  content         String   @db.Text
  embedding       Bytes?   @db.LongBlob
  connections     Json     @default("[]") // [memoryId, ...]
  strength        Float    @default(1.0)
  userId          String?
  createdAt       DateTime @default(now())

  idea         Idea?         @relation(fields: [ideaId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  cognition    Cognition?    @relation(fields: [cognitionId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([userId])
}

// 灵感墓地
model Graveyard {
  id               String    @id @default(cuid())
  originalIdeaId   String    @unique
  reason           String    @db.Text
  reviveCondition  String    @db.Text
  abandonedAt      DateTime  @default(now())
  revivedAt        DateTime?

  idea Idea @relation(fields: [originalIdeaId], references: [id])

  @@index([revivedAt])
}

// 认知库
model Cognition {
  id            String   @id @default(cuid())
  type          String   // method | experience | prompt
  content       String   @db.Text
  source        String   @default("manual") // conversation | idea | manual
  ideaId        String?
  conversationId String?
  tags          Json     @default("[]")
  userId        String?
  createdAt     DateTime @default(now())

  idea         Idea?         @relation(fields: [ideaId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  memories     Memory[]
  user         User?         @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([userId])
}

// 今日聚焦
model DailyFocus {
  id          String   @id @default(cuid())
  date        DateTime @unique
  cardIds     Json     @default("[]") // [taskId, taskId, taskId]
  generatedAt DateTime @default(now())
  status      String   @default("pending") // pending | completed
  userId      String?

  user  User?            @relation(fields: [userId], references: [id])
  items DailyFocusItem[]

  @@index([date])
  @@index([userId])
}

model DailyFocusItem {
  id           String  @id @default(cuid())
  dailyFocusId String
  taskId       String
  position     Int     @default(0)
  completed    Boolean @default(false)

  dailyFocus DailyFocus @relation(fields: [dailyFocusId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id])
}

// Skill - 可复用技能模板
model Skill {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  category    String   @default("general") // general | finance | report | review | knowledge | meeting | product | custom
  content     String   @db.LongText        // Markdown 正文（含步骤、提示词模板）
  parameters  Json     @default("[]")      // 参数定义数组
  promptTemplate String @db.LongText       // AI 提示词模板（用 {{param}} 占位）
  source      String   @default("manual")  // manual | imported | ai-generated
  tags        Json     @default("[]")
  usageCount  Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User?          @relation(fields: [userId], references: [id])
  versions SkillVersion[]

  @@index([category])
  @@index([source])
  @@index([userId])
}

// Skill 版本历史
model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  version     Int      // 版本号，从 1 递增
  name        String
  description String   @db.Text
  category    String
  content     String   @db.LongText
  parameters  Json     @default("[]")
  promptTemplate String @db.LongText
  tags        Json     @default("[]")
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@unique([skillId, version])
}

// Skill 评分/评论
model SkillReview {
  id        String   @id @default(cuid())
  skillId   String
  rating    Int      // 1-5 星
  comment   String   @db.Text
  author    String   @default("匿名用户")
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([skillId])
  @@index([rating])
  @@index([userId])
}

// 飞书任务（数据库持久化缓存）
model LarkTask {
  guid        String   @id
  summary     String   @db.Text
  description String   @db.LongText
  createdAt   DateTime?
  updatedAt   DateTime?
  dueAt       DateTime?
  dueIsAllDay Boolean  @default(false)
  startAt     DateTime?
  startIsAllDay Boolean @default(false)
  url         String   @default("")
  completed   Boolean  @default(false)
  completedAt DateTime?
  status      String   @default("incomplete")
  priority    Int      @default(0)
  assignees   Json     @default("[]")
  collaborators Json  @default("[]")
  followers   Json     @default("[]")
  creator     Json?
  tasklist    Json?
  members     Json     @default("[]")
  repeatRule  String   @db.Text
  location    Json?
  origin      Json?
  shortcuts   Json     @default("[]")
  reminders   Json     @default("[]")
  attachments Json     @default("[]")
  customCompleteRule String @db.Text
  customCompleted Boolean @default(false)
  originPlugin Json?
  commentCount Int     @default(0)
  followerCount Int    @default(0)
  subtaskCount Int     @default(0)
  parentTaskGuid String? @db.VarChar(64)
  syncedAt    DateTime @default(now())

  @@index([completed])
  @@index([status])
  @@index([dueAt])
  @@index([parentTaskGuid])
  @@index([completedAt])
}

// 飞书任务评论（数据库持久化，替代本地文件存储）
model LarkTaskComment {
  id        String   @id @default(cuid())
  taskGuid  String   @db.VarChar(64)
  content   String   @db.Text
  creatorId String?  @db.VarChar(64)
  creatorName String? @db.VarChar(100)
  source    String   @default("local") // local | lark
  createdAt DateTime @default(now())

  @@index([taskGuid])
  @@index([createdAt])
}

// 飞书 Webhook 事件（数据库持久化，替代内存队列）
model LarkWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique @db.VarChar(64)
  eventType String   @db.VarChar(64)
  taskGuid  String?  @db.VarChar(64)
  summary   String?  @db.Text
  raw       Json?
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([taskGuid])
  @@index([createdAt])
}

// AI 助理设置
model AISetting {
  id              String   @id @default(cuid())
  assistantName   String   @default("Lynn")
  // 音色复刻：克隆后的 voice_id（MiMo TTS VoiceClone 返回）
  clonedVoiceId   String?  @db.VarChar(255)
  clonedVoiceName String?  @db.VarChar(100)
  clonedAt        DateTime?
  // 默认 TTS 音色（未复刻时使用 mimo_default）
  defaultVoice    String   @default("mimo_default")
  // 是否开启语音自动播报（AI回复后自动朗读）
  autoSpeak       Boolean  @default(false)
  // 是否开启全双工语音对话模式
  voiceMode       Boolean  @default(false)
  // 飞书通知：是否启用紧急通知
  feishuNotify    Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([id])
}

// Embedding 缓存：避免重复计算相同文本的向量
// key 为文本内容的 SHA-256 哈希，value 为 Float32Array 的 Buffer
model EmbeddingCache {
  id        String   @id @default(cuid())
  textHash  String   @unique @db.VarChar(64) // SHA-256 hex
  embedding Bytes    @db.LongBlob
  provider  String   @default("tfidf") // ai | tfidf
  dim       Int      // 向量维度
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

// AI 助理对话会话
model ChatSession {
  id        String   @id @default(cuid())
  title     String   @default("新对话") @db.VarChar(200)
  provider  String   @default("deepseek") @db.VarChar(32)
  model     String?  @db.VarChar(64)
  pinned    Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@index([pinned])
  @@index([updatedAt])
  @@index([userId])
}

// AI 助理对话消息
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @db.VarChar(64)
  role      String   @db.VarChar(16) // user | assistant | system
  content   String   @db.LongText
  images    Json?    // 图片 URL 数组（多模态）
  provider  String?  @db.VarChar(32) // 生成该消息的 provider
  model     String?  @db.VarChar(64)
  tokens    Int?     // 消耗的 token 数
  durationMs Int?    // 生成耗时（毫秒）
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// AI 工作流（从 .ai-flows.json 迁移到 MySQL）
model Flow {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(200)
  description String   @db.Text
  nodes       Json     // FlowNode[]
  edges       Json     @default("[]") // FlowEdge[]
  enabled     Boolean  @default(true)
  lastRun     DateTime?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?            @relation(fields: [userId], references: [id])
  executions  FlowExecution[]

  @@index([userId])
  @@index([enabled])
}

// 工作流执行历史
model FlowExecution {
  id              String   @id @default(cuid())
  flowId          String
  flowName        String   @db.VarChar(200)
  success         Boolean
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  totalDurationMs Int      @default(0)
  finalOutput     String?  @db.LongText
  nodeResults     Json     // 节点执行结果数组
  error           String?  @db.Text
  userId          String?

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([flowId])
  @@index([startedAt])
  @@index([userId])
}

// Web Push 推送订阅
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json     // { p256dh, auth }
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}
