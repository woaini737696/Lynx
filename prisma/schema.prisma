// LynnHub Prisma Schema
// 数据库：MySQL 8.4

generator client {
  provider      = "prisma-client-js"
  // 本地 Windows 开发 + Linux 服务器部署，需同时生成两个平台的 query engine
  // 服务器零构建原则：不在服务器 prisma generate，本地生成后上传
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户系统
model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @db.VarChar(255)
  email        String?  @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(20) // 手机号（支持手机号登录）
  displayName  String   @default("") @db.VarChar(100)
  role         String   @default("viewer") // admin | editor | viewer
  profession   String?  @db.VarChar(100) // 职业
  avatarUrl    String?  @db.VarChar(500) // 头像 URL
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ===== 用户级 AI 大模型 Key 配置（可选，留空则使用管理员配置的全局 Key）=====
  userDeepseekApiKey String? @db.VarChar(255)
  userMimoApiKey     String? @db.VarChar(255)
  userAiProvider     String? @db.VarChar(32) // deepseek | mimo（用户默认 provider）

  // ===== 权限缓存版本号（角色变更时递增，用于多实例缓存失效）=====
  permissionVersion Int @default(0)

  ideas             Idea[]
  conversations     Conversation[]
  tasks             Task[]
  memories          Memory[]
  cognitions        Cognition[]
  dailyFocuses      DailyFocus[]
  skills            Skill[]
  skillReviews      SkillReview[]
  chatSessions      ChatSession[]
  flows             Flow[]
  flowExecutions    FlowExecution[]
  pushSubscriptions PushSubscription[]
  patrolRules       PatrolRule[]
  hermesConfig      HermesConfig?
  hermesReports     HermesReport[]
  skillFavorites    SkillFavorite[]
  skillExecutions   SkillExecution[]
  taskPatterns      TaskPattern[]
  larkTasks         LarkTask[]
  larkTaskComments  LarkTaskComment[]
  larkWebhookEvents LarkWebhookEvent[]

  // ===== 货币体系 & 会员 =====
  wallet              UserWallet?
  creditTransactions  CreditTransaction[]
  sCoinTransactions   SCoinTransaction[]
  membership          Membership?
  subscriptionOrders  SubscriptionOrder[]
}

// 角色权限配置
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // admin | editor | viewer | custom
  displayName String   @db.VarChar(50)
  description String   @db.Text
  permissions Json     @default("[]") // 权限key数组
  profession  String?  @db.VarChar(100) // 职业（绑定后用户被分配此角色时自动同步 profession）
  isSystem    Boolean  @default(false) // 系统内置角色不可删除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 任务模式学习：记录用户执行过的任务模式，用于自动执行同类任务
// 当用户手动完成一个任务后，系统学习任务模式；下次类似任务出现时可以自动执行
model TaskPattern {
  id                String    @id @default(cuid())
  userId            String
  // 任务类型关键词（从任务内容提取，如"创建灵感"、"完成看板任务"等）
  patternKey        String    @db.VarChar(200)
  // 任务描述模板（含参数占位符，如"创建灵感：{content}"）
  taskTemplate      String    @db.Text
  // 执行步骤（JSON 数组，记录用户执行过的操作序列）
  steps             Json      @default("[]")
  // 执行该模式所需的 Hermes prompt
  hermesPrompt      String    @db.LongText
  // 匹配关键词（JSON 数组，用于检测新任务是否匹配此模式）
  matchKeywords     Json      @default("[]")
  // 执行次数（用户手动执行 + 自动执行）
  executionCount    Int       @default(1)
  // 自动执行次数
  autoExecutedCount Int       @default(0)
  // 是否启用自动执行
  autoExecute       Boolean   @default(false)
  // 最后一次执行时间
  lastExecutedAt    DateTime?
  // 最后一次自动执行的结果（成功/失败）
  lastAutoResult    String?   @db.VarChar(20)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patternKey])
  @@index([autoExecute])
}

// 灵感 - 闪电输入源头
model Idea {
  id          String   @id @default(cuid())
  content     String   @db.Text
  source      String   @default("lightning") // lightning | conversation
  status      String   @default("inbox") // inbox | board | graveyard
  tags        Json     @default("[]")
  attachments Json     @default("[]") // 附件数组 [{type:"image"|"file", name, url, size}]
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  memories   Memory[]
  graveyard  Graveyard?
  cognitions Cognition[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, status, createdAt])
}

// 对话资产 - Kimi/Claude/Codex 捕获
model Conversation {
  id          String   @id @default(cuid())
  source      String // kimi | claude | codex | gpt
  title       String
  rawContent  String   @db.LongText
  conclusions Json     @default("[]")
  todos       Json     @default("[]")
  prompts     Json     @default("[]")
  data        Json     @default("[]")
  capturedAt  DateTime @default(now())
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories   Memory[]
  cognitions Cognition[]

  @@index([source])
  @@index([capturedAt])
  @@index([userId])
}

// 决策看板任务
model Task {
  id        String   @id @default(cuid())
  content   String   @db.Text
  column    String // northstar | campaign | task
  position  Int      @default(0)
  status    String   @default("active") // active | done | dropped
  sourceId  String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea Idea? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyFocusItems DailyFocusItem[]

  @@index([column, status])
  @@index([column, status, position])
  @@index([userId])
  @@index([createdAt])
  @@index([status, updatedAt])
  @@index([userId, column, status])
}

// 记忆节点 - 图谱
model Memory {
  id             String   @id @default(cuid())
  type           String // idea | conversation | cognition
  ideaId         String?
  conversationId String?
  cognitionId    String?
  content        String   @db.Text
  // 独立标签字段：用户自定义的显示标签，PATCH 时仅更新此字段，不再覆盖源实体内容
  label          String?  @db.VarChar(500)
  embedding      Bytes?   @db.LongBlob
  connections    Json     @default("[]") // [memoryId, ...]
  strength       Float    @default(1.0)
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  idea         Idea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  cognition    Cognition?    @relation(fields: [cognitionId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@index([strength])
  @@index([ideaId])
  @@index([conversationId])
  @@index([cognitionId])
  @@index([userId, createdAt])
}

// 灵感墓地
model Graveyard {
  id              String    @id @default(cuid())
  originalIdeaId  String    @unique
  reason          String    @db.Text
  reviveCondition String    @db.Text
  abandonedAt     DateTime  @default(now())
  revivedAt       DateTime?
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt

  idea Idea @relation(fields: [originalIdeaId], references: [id], onDelete: Cascade)

  @@index([revivedAt])
}

// 认知库
model Cognition {
  id             String   @id @default(cuid())
  type           String // method | experience | prompt
  content        String   @db.Text
  source         String   @default("manual") // conversation | idea | manual
  ideaId         String?
  conversationId String?
  tags           Json     @default("[]")
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  idea         Idea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  memories     Memory[]
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@index([ideaId])
  @@index([conversationId])
}

// 今日聚焦
model DailyFocus {
  id          String   @id @default(cuid())
  date        DateTime @unique
  cardIds     Json     @default("[]") // [taskId, taskId, taskId]
  generatedAt DateTime @default(now())
  status      String   @default("pending") // pending | completed
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  user  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DailyFocusItem[]

  @@index([date])
  @@index([userId])
}

model DailyFocusItem {
  id           String   @id @default(cuid())
  dailyFocusId String
  taskId       String
  position     Int      @default(0)
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt

  dailyFocus DailyFocus @relation(fields: [dailyFocusId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Skill - 可复用技能模板
model Skill {
  id             String   @id @default(cuid())
  name           String
  description    String   @db.Text
  category       String   @default("general") // general | finance | report | review | knowledge | meeting | product | custom
  content        String   @db.LongText // Markdown 正文（含步骤、提示词模板）
  parameters     Json     @default("[]") // 参数定义数组
  promptTemplate String   @db.LongText // AI 提示词模板（用 {{param}} 占位）
  source         String   @default("manual") // manual | imported | ai-generated | marketplace
  tags           Json     @default("[]")
  usageCount     Int      @default(0)
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 公共广场字段
  isPublic      Boolean   @default(false) // 是否发布到公共广场
  publicId      String?   @unique // 广场全局唯一标识（发布时生成）
  publishedAt   DateTime? // 发布时间
  downloadCount Int       @default(0) // 从广场加载次数
  ratingAvg     Float     @default(0) // 广场评分平均（冗余，定期更新）

  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions SkillVersion[]

  @@index([category])
  @@index([source])
  @@index([userId])
  @@index([isPublic])
  @@index([userId, category])
}

// Skill 版本历史
model SkillVersion {
  id             String   @id @default(cuid())
  skillId        String
  version        Int // 版本号，从 1 递增
  name           String
  description    String   @db.Text
  category       String
  content        String   @db.LongText
  parameters     Json     @default("[]")
  promptTemplate String   @db.LongText
  tags           Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId])
}

// Skill 评分/评论
model SkillReview {
  id        String   @id @default(cuid())
  skillId   String // 本地 Skill ID（兼容旧数据）
  publicId  String? // 公共广场技能标识（跨用户聚合评论用）
  rating    Int // 1-5 星
  comment   String   @db.Text
  author    String   @default("匿名用户")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([publicId])
  @@index([rating])
  @@index([userId])
}

// 飞书任务（数据库持久化缓存）
model LarkTask {
  guid               String    @id
  summary            String    @db.Text
  description        String    @db.LongText
  larkCreatedAt      DateTime?
  larkUpdatedAt      DateTime?
  dueAt              DateTime?
  dueIsAllDay        Boolean   @default(false)
  startAt            DateTime?
  startIsAllDay      Boolean   @default(false)
  url                String    @default("")
  completed          Boolean   @default(false)
  completedAt        DateTime?
  status             String    @default("incomplete")
  priority           Int       @default(0)
  assignees          Json      @default("[]")
  collaborators      Json      @default("[]")
  followers          Json      @default("[]")
  creator            Json?
  tasklist           Json?
  members            Json      @default("[]")
  repeatRule         String    @db.Text
  location           Json?
  origin             Json?
  shortcuts          Json      @default("[]")
  reminders          Json      @default("[]")
  attachments        Json      @default("[]")
  customCompleteRule String    @db.Text
  customCompleted    Boolean   @default(false)
  originPlugin       Json?
  commentCount       Int       @default(0)
  followerCount      Int       @default(0)
  subtaskCount       Int       @default(0)
  parentTaskGuid     String?   @db.VarChar(64)
  syncedAt           DateTime  @default(now())
  userId             String?
  createdAt          DateTime? @default(now())
  updatedAt          DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completed])
  @@index([status])
  @@index([dueAt])
  @@index([parentTaskGuid])
  @@index([completedAt])
}

// 飞书任务评论（数据库持久化，替代本地文件存储）
model LarkTaskComment {
  id          String   @id @default(cuid())
  taskGuid    String   @db.VarChar(64)
  content     String   @db.Text
  creatorId   String?  @db.VarChar(64)
  creatorName String?  @db.VarChar(100)
  source      String   @default("local") // local | lark
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskGuid])
  @@index([userId])
  @@index([createdAt])
}

// 飞书 Webhook 事件（数据库持久化，替代内存队列）
model LarkWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique @db.VarChar(64)
  eventType String   @db.VarChar(64)
  taskGuid  String?  @db.VarChar(64)
  summary   String?  @db.Text
  raw       Json?
  processed Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([taskGuid])
  @@index([userId])
  @@index([createdAt])
}

// AI 助理设置
model AISetting {
  id               String    @id @default("default")
  assistantName    String    @default("Lynn")
  // 自定义头像 URL（为空则使用默认 Bot 图标）
  avatarUrl        String?   @db.VarChar(500)
  // 默认 Emoji 头像（无 URL 时使用，移动端/Web端同步）
  assistantAvatar  String    @default("🤖") @db.VarChar(16)
  // 聊天风格描述（如"幽默、简洁、用emoji"），注入 system prompt
  personaStyle     String?   @db.Text
  // 蒸馏的真人聊天风格（从聊天记录提取的风格特征）
  distilledStyle   String?   @db.LongText
  // 风格强度（0.0-1.0，控制蒸馏风格对 AI 回复的影响程度，默认 0.7）
  styleStrength    Float     @default(0.7)
  // 音色复刻：克隆后的 voice_id（MiMo TTS VoiceClone 返回）
  clonedVoiceId    String?   @db.VarChar(255)
  clonedVoiceName  String?   @db.VarChar(100)
  clonedAt         DateTime?
  // 默认 TTS 音色（未复刻时使用 mimo_default）
  defaultVoice     String    @default("mimo_default")
  // 是否开启语音自动播报（AI回复后自动朗读）
  autoSpeak        Boolean   @default(false)
  // 是否开启全双工语音对话模式
  voiceMode        Boolean   @default(false)
  // 飞书通知：是否启用紧急通知
  feishuNotify     Boolean   @default(false)
  // Hermes 接管模式：开启后 AI 助理由 Hermes Agent 驱动（持久化记忆 + 持续学习 + 自动成长）
  hermesTakeover   Boolean   @default(true)
  // Hermes 主动汇报：开启后 Hermes Cron 定时分析用户数据并推送汇报（模式 C：持续工作/主动汇报/跨平台响应）
  hermesAutoReport Boolean   @default(true)
  // Hermes 主动汇报 cron 表达式（默认每天 9:00）
  hermesReportCron String    @default("0 9 * * *") @db.VarChar(64)
  updatedAt        DateTime  @updatedAt

  // LLM Provider 配置（数据库存储，优先级高于环境变量）
  // 留空时回退到 .env 中的 DEEPSEEK_API_KEY / MIMO_API_KEY 等
  defaultProvider  String? @db.VarChar(32) // deepseek | mimo | openai
  // DeepSeek
  deepseekApiKey   String? @db.VarChar(255)
  deepseekBaseUrl  String? @db.VarChar(255)
  deepseekModel    String? @db.VarChar(64)
  // MiMo
  mimoApiKey       String? @db.VarChar(255)
  mimoBaseUrl      String? @db.VarChar(255)
  mimoModel        String? @db.VarChar(64)
  // Embedding
  embeddingApiKey  String? @db.VarChar(255)
  embeddingBaseUrl String? @db.VarChar(255)
  embeddingModel   String? @db.VarChar(64)

  // 飞书自定义机器人 Webhook 配置（从 localStorage 迁移到数据库持久化）
  larkWebhookUrl   String? @db.VarChar(500)
  larkWebhookToken String? @db.VarChar(255)
}

// 职业 AI 工作空间（按 12 岗位差异化配置）
// 由 admin 角色统一管理；用户登录后按其 Role.profession 自动加载对应工作空间
model ProfessionWorkspace {
  id          String  @id @default(cuid())
  // 职业 key（唯一），如 pm / designer / frontend / backend / data / operations / marketing / hr / finance / project / creator / founder
  profession  String  @unique @db.VarChar(64)
  // 职业显示名
  displayName String  @db.VarChar(100)
  // 职业描述（用于 system prompt 注入）
  description String? @db.Text
  // 职业图标（emoji，如 📊）
  icon        String  @default("💼") @db.VarChar(16)
  // 颜色主题 key（orange/cognition/campaign/graveyard/northstar）
  accentColor String  @default("orange") @db.VarChar(32)

  // ============ 4 个定制维度 ============

  // 1) 快捷技能可见集（JSON 数组：[{key,label,description,icon,message}]）
  // 留空/null = 显示全部 QUICK_COMMANDS
  quickCommands Json @default("[]")

  // 2) System Prompt 模板（追加到 AI_ASSISTANT_SYSTEM_PROMPT 之后）
  // 留空/null = 不追加，使用默认系统提示词
  systemPrompt String? @db.LongText

  // 3) 默认 LLM Provider + Model + 推理模式
  // 留空/null = 使用全局默认（.env DEFAULT_LLM_PROVIDER）
  defaultProvider      String? @db.VarChar(32) // deepseek | mimo | openai
  defaultModel         String? @db.VarChar(64)
  defaultReasoningMode String? @db.VarChar(32) // standard | thinking | fast

  // 3.1) 允许使用的 AI 大模型列表（JSON 字符串数组：["deepseek","mimo"]）
  // 留空/null = 不限制（用户可使用所有已配置的 provider）
  // 非空 = 仅允许用户使用列表中的 provider（用户自配 Key 时也受此限制）
  allowedProviders Json @default("[]")

  // 4) 可见 AI 工具白名单（JSON 字符串数组：["searchIdeas","createTask", ...]）
  // 留空/null = 全部工具可用；非空则只允许调用白名单内的工具
  allowedTools Json @default("[]")

  // 是否启用（false 时该职业不应用工作空间，行为同未配置）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI 巡检规则（可配置）
model PatrolRule {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(200)
  description    String    @db.Text
  // 巡检对象：inbox | board | graveyard | all
  scope          String    @default("graveyard")
  // 触发时间：HH:mm 格式（如 "10:00"），或 "manual" 表示仅手动
  triggerTime    String    @default("10:00") @db.VarChar(8)
  // 巡检提示词（AI 用此 prompt 分析数据）
  prompt         String    @db.LongText
  // 匹配阈值（embedding 相似度阈值，0-1）
  threshold      Float     @default(0.75)
  // 通知渠道 JSON：["toast", "notification", "push", "feishu"]
  notifyChannels Json      @default("[\"toast\",\"notification\"]")
  // 是否启用
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PatrolLog[]

  @@index([scope])
  @@index([enabled])
  @@index([userId])
  @@index([userId, createdAt])
}

// AI 巡检执行日志
model PatrolLog {
  id         String    @id @default(cuid())
  ruleId     String
  ruleName   String    @db.VarChar(200)
  scope      String    @db.VarChar(32)
  success    Boolean
  // 巡检结果 JSON：[{itemId, content, matched, reason, suggestion}]
  results    Json      @default("[]")
  // 命中数
  hitCount   Int       @default(0)
  // 耗时（毫秒）
  durationMs Int       @default(0)
  error      String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  rule PatrolRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([startedAt])
}

// Embedding 缓存：避免重复计算相同文本的向量
// key 为文本内容的 SHA-256 哈希，value 为 Float32Array 的 Buffer
model EmbeddingCache {
  id        String   @id @default(cuid())
  textHash  String   @unique @db.VarChar(64) // SHA-256 hex
  embedding Bytes    @db.LongBlob
  provider  String   @default("tfidf") // ai | tfidf
  dim       Int // 向量维度
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

// AI 助理对话会话
model ChatSession {
  id        String   @id @default(cuid())
  title     String   @default("新对话") @db.VarChar(200)
  provider  String   @default("deepseek") @db.VarChar(32)
  model     String?  @db.VarChar(64)
  pinned    Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([pinned])
  @@index([updatedAt])
  @@index([userId])
  @@index([userId, updatedAt])
}

// AI 助理对话消息
model ChatMessage {
  id             String   @id @default(cuid())
  sessionId      String   @db.VarChar(64)
  role           String   @db.VarChar(16) // user | assistant | system
  content        String   @db.LongText
  images         Json? // 图片 URL 数组（多模态）
  provider       String?  @db.VarChar(32) // 生成该消息的 provider
  model          String?  @db.VarChar(64)
  tokens         Int? // 消耗的 token 数
  durationMs     Int? // 生成耗时（毫秒）
  // 用户标注反馈：good=好回复 | bad=不满意的回复（用于 HermesAgent 自主学习纠正）
  feedback       String?  @db.VarChar(8)
  feedbackReason String?  @db.VarChar(8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([sessionId, createdAt])
}

// AI 工作流（从 .ai-flows.json 迁移到 MySQL）
model Flow {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(200)
  description String    @db.Text
  nodes       Json      @default("[]") // FlowNode[]
  edges       Json      @default("[]") // FlowEdge[]
  enabled     Boolean   @default(true)
  lastRun     DateTime?
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions FlowExecution[]

  @@index([userId])
  @@index([enabled])
}

// 工作流执行历史
model FlowExecution {
  id              String    @id @default(cuid())
  flowId          String
  flowName        String    @db.VarChar(200)
  success         Boolean
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  totalDurationMs Int       @default(0)
  finalOutput     String?   @db.LongText
  nodeResults     Json // 节点执行结果数组
  error           String?   @db.Text
  userId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt

  flow Flow  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([startedAt])
  @@index([userId])
}

// Web Push 推送订阅
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json // { p256dh, auth }
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Hermes Agent 配置（每用户唯一）
// 用于一键部署本地 Hermes Agent，让用户通过 Agent 操控自己的电脑
model HermesConfig {
  id            String    @id @default(cuid())
  userId        String    @unique
  // 是否启用 Hermes 集成
  enabled       Boolean   @default(false)
  // Hermes Agent Dashboard 端点，默认 http://localhost:9119
  endpoint      String    @default("http://localhost:9119") @db.VarChar(255)
  // API Key（如 Hermes 启用了鉴权）
  apiKey        String?   @db.VarChar(255)
  // 是否随系统自动启动
  autoStart     Boolean   @default(false)
  // 启用的能力集合：["computer_use", "shell", "mcp", "skills_hub"]
  capabilities  Json      @default("[\"computer_use\",\"shell\",\"skills_hub\"]")
  // 安装时间（pip install hermes-agent 成功后写入）
  installedAt   DateTime?
  // 安装状态：not_installed | installing | installed | running | error
  status        String    @default("not_installed") @db.VarChar(32)
  // 最近一次状态检查时间
  lastCheckedAt DateTime?
  // 安装/运行错误信息（status=error 时）
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Hermes Agent 主动汇报（模式 C：持续工作/主动汇报/跨平台响应）
// Hermes Cron 定时分析用户数据生成汇报，通过 Web Push 跨平台推送
model HermesReport {
  id          String   @id @default(cuid())
  userId      String
  // 汇报类型：daily（每日）/ weekly（每周）/ patrol（巡检）/ custom（自定义）
  type        String   @default("daily") @db.VarChar(32)
  // 汇报标题
  title       String   @db.VarChar(255)
  // 汇报内容（Markdown）
  content     String   @db.LongText
  // Hermes 执行的原始输出
  rawOutput   String?  @db.LongText
  // 触发方式：cron（定时）/ manual（手动）/ patrol（巡检接管）
  trigger     String   @default("cron") @db.VarChar(16)
  // 是否成功推送
  pushed      Boolean  @default(false)
  // 推送渠道：web_push | feishu | email
  pushChannel String?  @db.VarChar(32)
  // 执行耗时（毫秒）
  durationMs  Int      @default(0)
  // 错误信息
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

// 技能收藏（用户在助理技能面板收藏的技能）
model SkillFavorite {
  id        String   @id @default(cuid())
  userId    String
  // 技能 ID（本地 Skill 表或 Hermes Skills Hub 的技能 ID）
  skillId   String   @db.VarChar(100)
  // 技能来源：local | hermes
  source    String   @default("local") @db.VarChar(16)
  // 冗余存储技能名称，便于列表展示
  skillName String   @db.VarChar(200)
  // 冗余存储技能分类
  category  String   @default("general") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([source])
}

// 技能执行历史（记录用户通过助理/工作流调用技能的执行记录）
model SkillExecution {
  id         String   @id @default(cuid())
  userId     String
  // 技能 ID（本地 Skill 表或 Hermes Skills Hub 的技能 ID）
  skillId    String   @db.VarChar(100)
  skillName  String   @db.VarChar(200)
  // 来源：local | hermes
  source     String   @default("local") @db.VarChar(16)
  // 调用来源：assistant | flow
  trigger    String   @default("assistant") @db.VarChar(16)
  // 调用参数 JSON
  parameters Json     @default("{}")
  // 执行结果（完整输出）
  result     String   @db.LongText
  success    Boolean  @default(true)
  // 执行耗时（毫秒）
  durationMs Int      @default(0)
  // 错误信息（success=false 时）
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([skillId])
  @@index([source])
}

// ============ 桌面端 / 多端协同 ============

// PC 在线会话：桌面端/HermesAgent 启动后注册到云端
// 用于安卓端/Web端远程操控 PC
model PcSession {
  id            String   @id @default(cuid())
  userId        String
  // 设备名（用户自定义，如"公司电脑"）
  deviceName    String   @db.VarChar(100)
  // HermesAgent 版本号
  agentVersion  String   @db.VarChar(32)
  // 能力清单 JSON：["browser","desktop","file","shell"]
  capabilities  Json     @default("[]")
  // WebSocket 通道 ID（用于云端路由指令到对应 PC）
  wsChannelId   String   @unique @db.VarChar(100)
  // 在线状态：online | offline | busy
  status        String   @default("online") @db.VarChar(16)
  // 授权模式：approve | once | free
  authMode      String   @default("approve") @db.VarChar(16)
  // 最后心跳时间
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([lastHeartbeat])
}

// 远程指令：安卓端/Web端发往 PC 端的指令记录
model RemoteCommand {
  id             String    @id @default(cuid())
  commandId      String    @unique @db.VarChar(100)
  userId         String
  // 指令内容（自然语言）
  command        String    @db.Text
  // 目标设备 ID（多 PC 时指定，空则广播）
  targetDeviceId String?   @db.VarChar(100)
  // 来源端：web | android | desktop
  source         String    @default("web") @db.VarChar(16)
  // 执行状态：pending | executing | completed | failed | timeout
  status         String    @default("pending") @db.VarChar(16)
  // 路由类型：cloud | local:browser | local:desktop | local:file | local:shell | hybrid
  route          String?   @db.VarChar(32)
  // 执行结果 JSON
  result         Json?
  // 错误信息
  error          String?   @db.Text
  // 执行耗时（毫秒）
  durationMs     Int       @default(0)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime? @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@index([commandId])
}

// Agent 操作审计日志：所有本地操作均记录（L2/L3 必记，L1 可选）
// 用于事后追溯、安全审计、行为分析
model AgentAuditLog {
  id         String   @id @default(cuid())
  userId     String
  // 操作类型：browser_open | browser_extract | desktop_open_app | desktop_screenshot
  //         | file_read | file_write | file_list | shell_exec | cloud_api
  action     String   @db.VarChar(64)
  // 权限等级：L1 | L2 | L3
  level      String   @db.VarChar(8)
  // 操作详情（命令、路径、参数等）
  detail     String   @db.Text
  // 授权模式：approve | once | free
  authMode   String   @db.VarChar(16)
  // 是否经过用户审批
  approved   Boolean  @default(false)
  // 执行结果：success | failed | denied | timeout
  result     String   @db.VarChar(16)
  // 来源端：web | android | desktop
  source     String   @default("desktop") @db.VarChar(16)
  // 来源设备名
  deviceName String?  @db.VarChar(100)
  // 耗时（毫秒）
  durationMs Int      @default(0)
  // 错误信息
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([userId, createdAt])
  @@index([action])
  @@index([level])
  @@index([result])
}

// 系统配置（key-value）：存储万能验证码、功能开关等全局配置
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(64) // 如 "master_code"、"master_code_enabled"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.VarChar(64) // 管理员 userId
}

// 邀请码：管理员批量生成，用户注册时必须提供有效邀请码
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique @db.VarChar(32) // 邀请码（8位大写字母+数字）
  status    String    @default("unused") @db.VarChar(16) // unused | used | disabled
  createdBy String    @db.VarChar(64) // 创建者 userId
  usedBy    String?   @db.VarChar(64) // 使用者 userId
  usedAt    DateTime?
  expiresAt DateTime? // 过期时间（null 表示永久有效）
  remark    String?   @db.VarChar(200) // 备注（如"市场部批量"）
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([createdBy])
}

// ============ 货币体系 & 会员机制 ============

// 用户钱包：Credits 点数（系统消耗币）+ S币（系统交易币）
// Credits：购买 AI 词元、系统权益、会员等。15 Credits = 1 基础 token
// S币：购买技能、蒸馏知识、AI 工作流、抵扣会员现金（1元 = 50 S币）
model UserWallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // Credits 余额（BigInt 支持亿级数值，如 30亿 = 3,000,000,000）
  credits             BigInt   @default(0)
  // S币 余额
  sCoins              Int      @default(0)
  // 冻结的 Credits（预扣未结算，如 AI 对话进行中）
  frozenCredits       BigInt   @default(0)
  // 累计统计
  totalCreditsEarned  BigInt   @default(0)
  totalCreditsSpent   BigInt   @default(0)
  totalSCoinsEarned   Int      @default(0)
  totalSCoinsSpent    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Credits 交易流水
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  // earn | spend | freeze | unfreeze | refund
  type         String   @db.VarChar(16)
  // 金额（正数）
  amount       BigInt
  // 操作后余额
  balanceAfter BigInt
  // 原因：ai_chat | buy_membership | membership_gift | sign_in | task_reward | recharge | admin_adjust | buy_token_pack
  reason       String   @db.VarChar(64)
  description  String?  @db.VarChar(500)
  // 元数据：{model, inputTokens, outputTokens, multiplier, orderId, ...}
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason])
  @@index([type])
}

// S币 交易流水
model SCoinTransaction {
  id           String   @id @default(cuid())
  userId       String
  // earn | spend
  type         String   @db.VarChar(16)
  amount       Int
  balanceAfter Int
  // 原因：buy_skill | buy_knowledge | buy_flow | sell_skill | membership_gift | sign_in | tip | membership_offset
  reason       String   @db.VarChar(64)
  description  String?  @db.VarChar(500)
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason])
}

// 会员订阅
model Membership {
  id              String   @id @default(cuid())
  userId          String   @unique
  // FREE | LITE | PRO | MAX | ULTRA
  tier            String   @default("FREE") @db.VarChar(16)
  // ACTIVE | EXPIRED | CANCELLED | PENDING
  status          String   @default("ACTIVE") @db.VarChar(16)
  // 订阅开始时间
  startedAt       DateTime?
  // 到期时间（null = 永久免费版）
  expiresAt       DateTime?
  // 自动续费
  autoRenew       Boolean  @default(false)
  // 计费周期：monthly | quarterly | yearly
  billingCycle    String?  @db.VarChar(16)
  // 已支付金额
  pricePaid       Decimal? @db.Decimal(10, 2)
  // 上次 Credits 月度发放时间
  lastCreditsGrant DateTime?
  // 上次 S币 月度发放时间
  lastSCoinsGrant  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 订阅订单
model SubscriptionOrder {
  id            String    @id @default(cuid())
  userId        String
  // LITE | PRO | MAX | ULTRA
  tier          String    @db.VarChar(16)
  // monthly | quarterly | yearly
  cycle         String    @db.VarChar(16)
  // 订单金额（元）
  amount        Decimal   @db.Decimal(10, 2)
  // S币抵扣金额（元）
  sCoinOffset   Decimal   @db.Decimal(10, 2) @default(0)
  // 抵扣使用的 S币数量
  sCoinUsed     Int       @default(0)
  // 实付金额（元）= amount - sCoinOffset
  actualAmount  Decimal   @db.Decimal(10, 2)
  // pending | paid | failed | refunded | cancelled
  status        String    @default("pending") @db.VarChar(16)
  // 支付方式：alipay | wechat | scoin_only | manual
  paymentMethod String?   @db.VarChar(32)
  // 第三方支付流水号
  tradeNo       String?   @db.VarChar(100)
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([tier])
}
