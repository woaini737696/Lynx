# 奇思部署凭据环境变量模板
# 复制为 .env.deploy 并填入真实值（.env.deploy 已在 .gitignore 中排除）
# 所有 scripts/deploy/ 下的脚本统一从环境变量读取凭据，禁止硬编码

# 服务器 SSH 凭据
DEPLOY_SSH_HOST=47.119.185.135
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=

# MySQL 凭据（与 SSH 密码可能不同）
DEPLOY_MYSQL_USER=lynx
DEPLOY_MYSQL_PASSWORD=
DEPLOY_MYSQL_DATABASE=lynx

# Gitee Release Token（用于发布桌面端/安卓端安装包）
GITEE_TOKEN=

# Android 签名密码（写入 android/local.properties，已 gitignore）
ANDROID_STORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# 桌面端代码签名证书密码（PFX）
DESKTOP_SIGN_PASSWORD=

# 测试管理员密码（仅 e2e 测试用，生产环境请修改默认密码）
TEST_ADMIN_PASSWORD=
