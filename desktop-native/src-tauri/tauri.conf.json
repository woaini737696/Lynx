{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "奇思",
  "version": "1.0.33",
  "identifier": "com.lynx.app",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../out/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "奇思",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss: ipc:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss: ipc:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "publisher": "Lynn",
    "copyright": "© 2026 Lynn. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Lynx 全平台智能助理桌面端",
    "longDescription": "Lynx 原生桌面端，本地前端 + 云端 API，安装即用，支持全局唤起与自动更新。",
    "resources": ["lynx-code-sign.cer"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "both",
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://ai.lynxdo.com/api/desktop/update"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGOTU5OTExMTNBNDQyNgpSV1FtUkRvUmtWbjVCUStNYnRKY1hYQytJRllCVzMvakxQSlVheXhOcERHQ0VlWUpURGN1NUJzeAo=",
      "dialog": true
    }
  }
}
