# LynnHub 环境变量

# ============ 数据库（MySQL，已启用）============
DATABASE_URL="mysql://root@localhost:3306/lynnhub"

# ECS 部署时如有密码：
# DATABASE_URL="mysql://root:你的密码@localhost:3306/lynnhub?charset=utf8mb4"

# ============ AI Provider（OpenAI 兼容协议）============
# 任选其一，全部走 OpenAI 兼容接口
# 不配置 key 时：对话资产/认知库的 AI 提取会跳过，记忆图谱降级为 TF-IDF 关键词匹配

# ---- 方案 A：OpenAI 官方（功能最全，含 embedding）----
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 方案 B：硅基流动 SiliconFlow（国内推荐，含 embedding）----
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_EMBEDDING_MODEL=BAAI/bge-m3

# ---- 方案 C：DeepSeek（无 embedding，图谱降级为 TF-IDF）----
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=deepseek-chat

# ---- 方案 D：Kimi / Moonshot（无 embedding，图谱降级为 TF-IDF）----
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=moonshot-v1-8k

# ============ Embedding 独立配置（可选）============
# 若 chat 和 embedding 用不同 Provider（如 DeepSeek chat + 硅基流动 embedding）
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_API_KEY=sk-xxxxxxxx
# AI_EMBEDDING_MODEL=BAAI/bge-m3

# ============ 说明 ============
# 1. 复制本文件为 .env，填入实际 key
# 2. 重启 dev server 生效
# 3. AI_API_KEY 仅服务端使用，不会打包到前端
# 4. 无 key 时所有功能仍可运行，AI 相关功能降级
