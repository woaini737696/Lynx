# LynnHub 环境变量

# ============ 数据库（MySQL）============
DATABASE_URL="mysql://root@localhost:3306/lynnhub"

# ECS 部署时如有密码：
# DATABASE_URL="mysql://root:你的密码@localhost:3306/lynnhub?charset=utf8mb4"

# ============ LLM 大模型配置（支持动态切换）============
# DeepSeek V4 Flash
DEEPSEEK_API_KEY="sk-xxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# 小米 MiMo v2.5
MIMO_API_KEY="sk-xxxxxxxx"
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5"

# 默认 LLM 提供商（deepseek / mimo）
DEFAULT_LLM_PROVIDER="deepseek"

# ============ 向量模型（Embedding）============
# 硅基流动聚合平台，支持 BGE-M3
# 获取 Key：https://siliconflow.cn
EMBEDDING_API_KEY="sk-xxxxxxxx"
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_MODEL="BAAI/bge-m3"

# ============ ASR 语音识别（小米 MiMo）============
# 使用 /chat/completions 端点，共用 MIMO_API_KEY
ASR_API_KEY="sk-xxxxxxxx"
ASR_BASE_URL="https://api.xiaomimimo.com/v1"
ASR_MODEL="mimo-v2.5-asr"

# ============ TTS 语音合成（小米 MiMo）============
# 使用 /chat/completions 端点，共用 MIMO_API_KEY
TTS_API_KEY="sk-xxxxxxxx"
TTS_BASE_URL="https://api.xiaomimimo.com/v1"
TTS_MODEL="mimo-v2.5-tts"

# TTS 音色复刻
TTS_VOICECLONE_MODEL="mimo-v2.5-tts-voiceclone"

# ============ 视觉多模态模型（可选）============
# 复用 DeepSeek 或其他支持视觉的模型
VISION_API_KEY="sk-xxxxxxxx"
VISION_BASE_URL="https://api.deepseek.com/v1"
VISION_MODEL="deepseek-chat"

# ============ 飞书集成 ============
# 飞书应用凭证（用于调用 OpenAPI 读取任务详情）
LARK_APP_ID="cli_xxxxxxxxxxxxxxxx"
LARK_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 飞书 Webhook 验证 Token
LARK_WEBHOOK_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============ 用户认证（next-auth）============
# 生成命令：openssl rand -base64 32
AUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============ 错误监控（Sentry，可选）============
# 部署阶段启用：npm install @sentry/nextjs
# 获取 DSN：https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=""

# ============ Web Push 推送通知 ============
# VAPID keys 用于 Web Push 通知的身份验证
# 生成命令：npx web-push generate-vapid-keys
# VAPID_SUBJECT 填写 mailto: 链接或你的网站 URL
VAPID_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:your-email@example.com"

# ============ 说明 ============
# 1. 复制本文件为 .env，填入实际 key
# 2. 重启 dev server 生效
# 3. 所有 API Key 仅服务端使用，不会打包到前端
# 4. 无 key 时所有功能仍可运行，AI 相关功能降级
